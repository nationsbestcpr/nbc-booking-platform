# Copy to .env for local development. In staging and production these are
# Replit Secrets, never committed. Secret VALUES never go in this file.

APP_ENV=local                      # local | staging | production (must match app_settings.environment)
DATABASE_URL=postgresql://postgres@localhost:5432/nbc
SECRET_KEY=                        # required outside local: 32+ random characters
PUBLIC_BASE_URL=http://localhost:5000

# Demo accounts (db/demo.sql, local only) sign in with the password: demo-password

# Integrations (names only; values go in Replit Secrets). See README "Integrations".
# AIRTABLE_TOKEN=                   # personal access token: data.records:read + schema.bases:read, NBC Master Base only
# AIRTABLE_BASE_ID=                 # app... (from the base's address in the browser)
# AIRTABLE_SYNC_MINUTES=5           # optional
# AIRTABLE_TABLE_SCHEDULE=          # optional, only if a table was renamed (default "Class Schedule")
# AIRTABLE_TABLE_LOCATIONS=         # optional (default "Master Locations")
# AIRTABLE_TABLE_COURSES=           # optional (default "Course Master")
# STRIPE_SECRET_KEY=                # sk_test_... outside production; sk_live_... in production only
# STRIPE_WEBHOOK_SECRET=            # whsec_... of the endpoint .../webhooks/stripe (test and live differ)
# GHL_API_TOKEN=                    # Private Integration token of the sub-account
# GHL_LOCATION_ID=                  # the sub-account id (Sandbox 2 in staging)
# GHL_PIPELINE_NAME=                # optional, default "Community Class"
# SUPERADMIN_EMAIL=                 # preset admin account, created on start (users ensure-superadmin)
# SUPERADMIN_PASSWORD=              # 12+ characters; only used when the account is first created
# SUPERADMIN_RESET_PASSWORD=yes   # once: use SUPERADMIN_PASSWORD for an existing account, then remove
# SUPERADMIN_NAME=                  # optional, default "Super Admin"
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
