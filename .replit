modules = ["python-3.12", "postgresql-16"]
# Packages live in the project's .venv (scripts/replit-setup.sh): Replit's own
# Python is read-only, so a plain `pip install` fails.
run = "sh scripts/replit-setup.sh && .venv/bin/flask --app wsgi run --host 0.0.0.0 --port 5000 --debug"

[deployment]
deploymentTarget = "vm"
build = ["sh", "scripts/replit-setup.sh"]
run = [".venv/bin/gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--access-logfile", "-", "wsgi:app"]

[[ports]]
localPort = 5000
externalPort = 80
