modules = ["python-3.12", "web", "bash"]
# Packages live in the project's .venv (scripts/replit-setup.sh): Replit's own
# Python is read-only and its pip wrapper forces --user installs, which fail.
# Run also brings the workspace database up to date with our migrations (so
# Replit never sees a difference to "fix" on publish) and sets up the preset
# admin from SUPERADMIN_* in the workspace's Secrets (neither stops Run).
run = "sh scripts/replit-setup.sh && (.venv/bin/python -m flask --app wsgi db upgrade || true) && (.venv/bin/python -m flask --app wsgi users ensure-superadmin || true) && .venv/bin/python -m flask --app wsgi run --host 0.0.0.0 --port 5000 --debug"

[deployment]
deploymentTarget = "vm"
# The published app brings its own database up to date before it starts, using
# our migrations. NEVER approve Replit's own "database changes" prompt on publish:
# it makes the published database match the workspace's and can drop columns
# our migrations added (it removed orders.buyer_user_id once; 0007 put it back).
# scripts/replit-start.sh prints a "[start]" line per step in the Logs tab.
run = ["sh", "scripts/replit-start.sh"]
build = ["sh", "scripts/replit-setup.sh"]

# Replit's own package installer is kept out of the way: no requirements.txt
# at the root (packages are in requirements/app.txt) and no guessing on Run.
[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
