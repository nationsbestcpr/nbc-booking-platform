modules = ["python-3.12", "web", "bash"]
# Packages live in the project's .venv (scripts/replit-setup.sh): Replit's own
# Python is read-only and its pip wrapper forces --user installs, which fail.
# Run also sets up the preset admin from SUPERADMIN_* in the workspace's Secrets
# (it never stops Run from starting).
run = "sh scripts/replit-setup.sh && (.venv/bin/python -m flask --app wsgi users ensure-superadmin || true) && .venv/bin/python -m flask --app wsgi run --host 0.0.0.0 --port 5000 --debug"

[deployment]
deploymentTarget = "vm"
# The published app brings its own database up to date before it starts, using
# our migrations. Don't approve Replit's own "database changes" prompt on publish:
# its generated SQL skips the extensions (citext, pg_trgm, btree_gist) and fails.
# scripts/replit-start.sh prints a "[start]" line per step in the Logs tab.
run = ["sh", "scripts/replit-start.sh"]
build = ["sh", "scripts/replit-setup.sh"]

# Replit's own package installer is kept out of the way: no requirements.txt
# at the root (packages are in requirements/app.txt) and no guessing on Run.
[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
